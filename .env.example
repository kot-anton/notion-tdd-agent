NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_VERSION=2022-06-28
GENERATED_FILES_DIR=generated
LOG_LEVEL=info

# Visual / image generation
# Set to false for faster draft generation (skips image calls, uses Mermaid + placeholders)
VISUAL_GENERATION_ENABLED=true

# Image generation provider
#
# auto   — (default) use best available: OpenAI if OPENAI_API_KEY is set, else Claude path
# openai — OpenAI DALL-E 3 bitmap generation (requires OPENAI_API_KEY)
# claude — Claude-native path: Mermaid/SVG diagrams, design specs, and image prompts (no bitmap)
# none   — minimal placeholders only, no image or diagram generation
#
# Note: Claude can always create Mermaid diagrams and SVG regardless of this setting.
# This setting controls whether real bitmap images (PNG/JPEG) are attempted.
#
# Future providers (not yet implemented): stability, replicate, local
IMAGE_PROVIDER=auto

# Required when IMAGE_PROVIDER=openai or auto (if you want real bitmap images)
OPENAI_API_KEY=

# Document quality mode: polished (default) or draft
# draft   — faster, no generated images, compact placeholders, diagrams only
# polished — full visuals when configured, partner-facing polish
DOCUMENT_QUALITY_MODE=polished
