NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_VERSION=2022-06-28
GENERATED_FILES_DIR=generated
LOG_LEVEL=info

# Visual / image generation
# Set to false for faster draft generation (skips image calls, uses Mermaid + placeholders)
VISUAL_GENERATION_ENABLED=true

# Image generation provider
#
# auto   — (default) No API key required. Uses Mermaid/SVG diagrams and image prompts by default.
#          Automatically upgrades to OpenAI DALL-E 3 bitmap images if OPENAI_API_KEY is set.
# claude — Mermaid/SVG diagrams and image prompts only. No API key required.
# openai — OpenAI DALL-E 3 bitmap images only (requires OPENAI_API_KEY; may incur charges).
# none   — minimal placeholders only, no diagram or image generation.
#
# Note: Mermaid diagrams always work regardless of this setting.
# This setting controls whether real bitmap images (PNG/JPEG) are attempted via an external API.
IMAGE_PROVIDER=auto

# Optional — only required when IMAGE_PROVIDER=openai or IMAGE_PROVIDER=auto with a key present.
# Leave blank to use the default Mermaid/SVG visual path (no charges, no key needed).
OPENAI_API_KEY=

# Document quality mode: polished (default) or draft
# draft   — faster, no generated images, compact placeholders, diagrams only
# polished — full visuals when configured, partner-facing polish
DOCUMENT_QUALITY_MODE=polished
